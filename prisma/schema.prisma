generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  EMPLOYEE
}

enum OrderStatus {
  PENDING_PAYMENT
  ACTIVE
  OPENED
  RESPONDED
  EXPIRED
  ARCHIVED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum CommissionRecipientType {
  EMPLOYEE
  STAFF
  AFFILIATE
}

enum CommissionStatus {
  PENDING
  EARNED
  PAID_OUT
  CANCELLED
}

enum RecipientResponse {
  YES
  NO
  MAYBE
  CUSTOM
}

enum LogAction {
  USER_CREATED
  USER_UPDATED
  USER_DELETED

  TEMPLATE_CREATED
  TEMPLATE_UPDATED
  TEMPLATE_DELETED
  TEMPLATE_PUBLISHED
  TEMPLATE_UNPUBLISHED

  ORDER_CREATED
  ORDER_UPDATED
  ORDER_ACTIVATED
  ORDER_ARCHIVED
  ORDER_CANCELLED

  PAYMENT_CREATED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED

  COMMISSION_CREATED
  COMMISSION_CANCELLED
  COMMISSION_PAID_OUT

  GIFT_OPENED
  RECIPIENT_RESPONDED
  TRACK_PAGE_VIEWED
}

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String
  role         Role    @default(EMPLOYEE)
  customRoleId String?
  customRole   CustomRole? @relation(fields: [customRoleId], references: [id])
  avatarUrl    String?
  isActive     Boolean @default(true)

  managerId String?
  manager   User?   @relation("StaffEmployees", fields: [managerId], references: [id])
  employees User[]  @relation("StaffEmployees")

  createdOrders Order[]      @relation("OrderCreator")
  commissions   Commission[]
  commissionOverrides UserCommissionOverride[]
  logs          OrderLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([customRoleId])
  @@index([managerId])
}

model CustomRole {
  id                   String  @id @default(cuid())
  name                 String  @unique
  description          String?
  baseRole             Role    @default(EMPLOYEE)
  permissions          Json?
  commissionPercentage Decimal @default(0) @db.Decimal(5, 2)
  isActive             Boolean @default(true)

  users               User[]
  roleCommissionRules RoleCommissionRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([baseRole])
}

model Affiliate {
  id        String  @id @default(cuid())
  name      String
  refCode   String  @unique
  email     String?
  phone     String?
  socialUrl String?
  isActive  Boolean @default(true)

  orders      Order[]
  commissions Commission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([refCode])
  @@index([isActive])
}

model Template {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  description  String?
  thumbnailUrl String?
  previewUrl   String?

  componentKey String
  dataSchema   Json?
  sampleData   Json?

  basePrice   Decimal @db.Decimal(12, 2)
  isPublished Boolean @default(false)
  sortOrder   Int     @default(0)

  orders Order[]
  roleCommissionRules RoleCommissionRule[]
  userCommissionOverrides UserCommissionOverride[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished])
  @@index([sortOrder])
}

model Order {
  id       String @id @default(cuid())
  publicId String @unique

  templateId String
  template   Template @relation(fields: [templateId], references: [id])

  createdById String
  createdBy   User   @relation("OrderCreator", fields: [createdById], references: [id])

  affiliateId String?
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id])

  buyerName         String?
  buyerContact      String?
  buyerSocialHandle String?

  customData Json
  amount     Decimal     @db.Decimal(12, 2)
  status     OrderStatus @default(PENDING_PAYMENT)

  giftOpenedAt  DateTime?
  lastTrackedAt DateTime?

  recipientResponse RecipientResponse?
  responseText      String?
  respondedAt       DateTime?
  expiresAt         DateTime?

  payment     Payment?
  commissions Commission[]
  logs        OrderLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@index([createdById])
  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id String @id @default(cuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("VND")
  paymentCode String        @unique
  status      PaymentStatus @default(PENDING)

  provider              String?
  providerTransactionId String?
  qrCodeUrl             String?
  rawWebhookPayload     Json?
  paidAt                DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentCode])
  @@index([status])
}

model Commission {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  recipientType CommissionRecipientType

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  affiliateId String?
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id])

  amount     Decimal          @db.Decimal(12, 2)
  percentage Decimal          @db.Decimal(5, 2)
  status     CommissionStatus @default(EARNED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([affiliateId])
  @@index([recipientType])
  @@index([status])
}

model RoleCommissionRule {
  id String @id @default(cuid())

  roleId String
  role   CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: Cascade)

  percentage Decimal @db.Decimal(5, 2)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, templateId])
  @@index([roleId])
  @@index([templateId])
}

model UserCommissionOverride {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: Cascade)

  recipientType CommissionRecipientType @default(EMPLOYEE)
  percentage    Decimal                 @db.Decimal(5, 2)
  isActive      Boolean                 @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, templateId, recipientType])
  @@index([userId])
  @@index([templateId])
}

model OrderLog {
  id String @id @default(cuid())

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id])

  action   LogAction
  metadata Json?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}
